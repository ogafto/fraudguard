# Copy to .env.local and fill in. Never commit .env.local.

# Postgres connection string. On Vercel: Storage → Neon → Connect, which sets it for you.
# Leave empty locally to use the embedded database stored in .data/pglite.
DATABASE_URL=

# Resend API key (https://resend.com/api-keys). Leave empty locally to print emails to the server console.
RESEND_API_KEY=

# Sender address. Without a verified domain in Resend, onboarding@resend.dev only delivers
# to the email you signed up to Resend with.
EMAIL_FROM="FraudGuard <onboarding@resend.dev>"

# Public address of the site, used in email links. Optional: defaults to the host of the request.
APP_URL=

# Comma separated emails that get access to /admin.
ADMIN_EMAILS=

# Encrypts the integration keys saved in the admin panel (Resend, Discord).
# Any long random string, e.g. `openssl rand -base64 36`. Changing it later makes saved keys unreadable.
APP_SECRET=
